# =============================================================================
#  Env-файл веб-приложения (задание №7).
#  Секреты в репозиторий не коммитятся: это демонстрационные значения,
#  совпадающие с паролями ролей из sql/01_schema.sql.
# =============================================================================

# Подключение к СУБД (host/port задаются в compose: db:5432)
DB_NAME=appdb
DB_CONNECT_TIMEOUT=10

# Журналы
APP_AUTH_LOG=/opt/app/logs/auth.log
APP_LOG_FILE=/opt/app/logs/webapp.log

# Секрет Flask для подписи cookie сессии
FLASK_SECRET_KEY=change-me-in-production-7f3c9a1b
