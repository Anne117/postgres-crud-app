# =============================================================================
#  Env-файл для Docker (пункт 6.8 задания).
#  Содержит РАБОЧИЕ примеры значений переменных среды из пункта 6.7:
#    * APP_LOG_FILE — путь к файлу, куда дублируются логи «в чистом виде»;
#    * APP_CONFIG    — путь к конфиг-файлу подключения внутри образа;
#    * PGUSER / PGPASSWORD — логин и пароль подключения к БД, полученные
#      «от пользователя» (в демонстрации берутся из этого файла).
#  Пароль ниже — демонстрационный (совпадает с паролем роли app_user
#  из sql/01_schema.sql); в реальной эксплуатации файл не публикуют.
# =============================================================================

# --- учётные данные пользователя БД, отличного от администратора ------------
PGUSER=app_user
PGPASSWORD=user_secret

# --- конфиг-файл подключения (внутри образа, host=db) ----------------------
APP_CONFIG=/opt/app/config/app.docker.conf

# --- дублирующий «сырой» журнал: путь к файлу ------------------------------
APP_LOG_FILE=/opt/app/logs/app.log

# --- параметры сервиса СУБД (используются образом postgres:18) --------------
POSTGRES_DB=appdb
POSTGRES_USER=app_admin
POSTGRES_PASSWORD=adminsecret
LANG=ru_RU.UTF-8
LC_ALL=ru_RU.UTF-8
LC_CTYPE=ru_RU.UTF-8
